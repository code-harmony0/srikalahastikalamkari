# Supabase Configuration
# Get these values from your Supabase project settings: https://app.supabase.com/project/_/settings/api

# Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=your-project-url.supabase.co

# Supabase Anon/Public Key (safe to expose in client-side code)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Service Role Key (KEEP SECRET - only use on server)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Razorpay
NEXT_PUBLIC_RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Cloudflare Images
NEXT_PUBLIC_CF_IMAGES_HASH=your-cloudflare-images-delivery-hash
CF_ACCOUNT_ID=your-cloudflare-account-id
CF_IMAGES_TOKEN=your-cloudflare-images-api-token

# Admin Credentials (server-side only — do NOT use NEXT_PUBLIC_ prefix)
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=your-secure-password
NEXT_PUBLIC_ADMIN_EMAILS=your-admin-email@example.com

# Optional debugging / migration compatibility
NEXT_PUBLIC_CF_IMAGES_ALLOW_SLUG_IDS=false
NEXT_PUBLIC_CF_IMAGES_ALLOW_SUPABASE_LEGACY_URLS=false
NEXT_PUBLIC_IMAGE_DEBUG=false
