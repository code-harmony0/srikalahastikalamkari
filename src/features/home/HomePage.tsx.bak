              >
                <motion.span
                  className="block"
                  initial={{ opacity: 0, x: -20 }}
                  whileInView={{ opacity: 1, x: 0 }}
                  transition={{ duration: 0.8, delay: 0.6 }}
                  viewport={{ once: true }}
                >
                  Woven in
                </motion.span>
                <motion.span 
                  className="block text-primary font-normal italic mt-2 relative"
                  initial={{ opacity: 0, x: 20 }}
