                        <p className="font-serif text-[#D4A05A] text-lg">{image.category}</p>
                      </div>
                    </motion.div>
                  </AnimatedElement>
                ))}
              </div>

              {/* Bottom Row - Balanced (Equal Height) */}
              <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
                {galleryImages.slice(3, 6).map((image, index) => (
                  <AnimatedElement key={index + 3} delay={(index + 3) * 100}>
                    <motion.div
                      whileHover={{ y: -6, scale: 1.02 }}
                      className="group relative overflow-hidden rounded-xl shadow-[0_4px_14px_rgba(0,0,0,0.05)] hover:shadow-[0_8px_24px_rgba(166,83,41,0.15)] transition-all duration-500 aspect-[4/3]"
                    >
                      <Image
                        src={image.src}
                        alt={image.alt}
                        fill
                        className="object-cover transition-transform duration-700 group-hover:scale-110"
                        sizes="(max-width: 768px) 100vw, 33vw"
                      />
                      {/* Hover Overlay */}
                      <div className="absolute inset-0 bg-gradient-to-t from-black/60 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex items-end p-6">
                        <p className="font-serif text-[#D4A05A] text-lg">{image.category}</p>
                      </div>
                    </motion.div>
                  </AnimatedElement>
                ))}
              </div>
            </div>
          </div>
        </section>

        {/* CUSTOMER TESTIMONIALS - Brand Trust (2026 Refinement) */}
        <section className="w-full py-20 md:py-28 relative overflow-hidden">
          {/* Background Gradient */}
          <div className="absolute inset-0 bg-gradient-to-br from-[#FFF4E8] to-[#FFF8F0]" />

          <div className="max-w-[120rem] mx-auto px-4 md:px-6 lg:px-8 relative z-10">
            {/* Section Header */}
            <div className="text-center mb-16">
              <span className="font-sans text-[11px] font-bold text-[#C19A5B] uppercase tracking-[0.25em] block mb-3">
                Testimonials
              </span>
              <h2 className="font-serif text-4xl md:text-5xl text-[#3B2C23] mb-4">Stories from Our Community</h2>
              <p className="font-sans text-lg text-[#3B2C23]/75 max-w-2xl mx-auto">
                Hear from customers who've experienced the beauty and craftsmanship of Srikalahasti Kalamkari.
              </p>
            </div>

            {/* Testimonial Grid */}
            <div className="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
              {[
                {
                  quote: "The intricate details and vibrant colors are breathtaking. Each piece tells a story that transcends time. Truly a masterpiece.",
                  name: "Priya Sharma",
                  city: "Mumbai"
                },
                {
                  quote: "I've never owned anything quite like this. The craftsmanship is impeccable, and wearing it makes me feel connected to centuries of tradition.",
                  name: "Ananya Reddy",
                  city: "Hyderabad"
                },
                {
                  quote: "Absolutely stunning work. The natural dyes and hand-painted motifs make every saree unique. Worth every rupee.",
                  name: "Lakshmi Iyer",
                  city: "Chennai"
                },
                {
                  quote: "Gifted this to my mother and she was moved to tears. The quality and authenticity are unmatched. Highly recommended.",
                  name: "Rajesh Kumar",
                  city: "Bangalore"
                }
              ].map((testimonial, index) => (
                <AnimatedElement key={index} delay={index * 150}>
                  <div className="relative p-8 bg-white/60 backdrop-blur-md rounded-[14px] shadow-sm hover:shadow-md transition-all duration-300 border border-[#3B2C23]/5">
                    {/* Quotation Mark */}
                    <div className="absolute top-6 left-6 text-[#D4A05A] text-5xl opacity-20 font-serif leading-none">"</div>
                    
                    {/* Quote */}
                    <p className="font-sans text-[17px] text-[#3A2B1F]/90 leading-relaxed mb-6 relative z-10">
                      {testimonial.quote}
                    </p>
                    
                    {/* Attribution */}
                    <div className="flex items-center gap-3">
                      <div className="w-10 h-10 rounded-full bg-[#A65329]/10 flex items-center justify-center">
                        <span className="text-[#A65329] font-medium text-sm">{testimonial.name.charAt(0)}</span>
                      </div>
                      <div>
                        <p className="font-sans text-sm font-semibold text-[#C19A5B] uppercase tracking-wider">
                          {testimonial.name}
                        </p>
                        <p className="font-sans text-xs text-[#3B2C23]/60">{testimonial.city}</p>
                      </div>
                    </div>
                  </div>
                </AnimatedElement>
              ))}
            </div>

            {/* Trust Metrics Row */}
            <div className="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-4xl mx-auto">
              {[
                { icon: Star, label: "4.9/5 Customer Rating", value: "4.9/5" },
                { icon: Award, label: "100% Handcrafted", value: "100%" },
                { icon: Users, label: "10,000+ Happy Customers", value: "10K+" }
              ].map((metric, index) => {
                const Icon = metric.icon;
                return (
                  <AnimatedElement key={index} delay={600 + index * 100}>
                    <motion.div
                      whileHover={{ y: -4, scale: 1.03 }}
                      className="p-6 bg-gradient-to-br from-[#A65329]/5 to-[#D4A05A]/5 rounded-xl border border-[#A65329]/10 shadow-sm hover:shadow-md transition-all duration-300 text-center"
                    >
                      <Icon className="w-8 h-8 text-[#A65329] mx-auto mb-3" />
                      <div className="font-serif text-2xl font-bold text-[#3B2C23] mb-1">{metric.value}</div>
                      <p className="font-sans text-sm text-[#3B2C23]/70">{metric.label}</p>
                    </motion.div>
                  </AnimatedElement>
                );
              })}
            </div>
          </div>
        </section>

          <div className="max-w-[120rem] mx-auto px-6 md:px-8 lg:px-12 mb-12">
