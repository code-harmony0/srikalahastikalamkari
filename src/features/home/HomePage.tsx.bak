              <p className="font-sans text-lg text-[#3B2C23]/75 max-w-2xl mx-auto">
                Explore the vibrant world of Kalamkari through our visual journal of artistry and tradition.
              </p>
            </div>

            {/* Mosaic Gallery Grid */}
            <div className="space-y-6">
              {/* Top Row - Asymmetric (2 Landscape + 1 Portrait) */}
              <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
                {galleryImages.slice(0, 3).map((image, index) => (
                  <AnimatedElement key={index} delay={index * 100}>
                    <motion.div
                      whileHover={{ y: -6, scale: 1.02 }}
                      className="group relative overflow-hidden rounded-xl shadow-[0_4px_14px_rgba(0,0,0,0.05)] hover:shadow-[0_8px_24px_rgba(166,83,41,0.15)] transition-all duration-500"
                      style={{ aspectRatio: index === 2 ? '3/4' : '4/3' }}
                    >
                      <Image
                        src={image.src}
                        alt={image.alt}
                        fill
                        className="object-cover transition-transform duration-700 group-hover:scale-110"
