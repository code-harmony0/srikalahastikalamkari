{
  "name": "com.shrikalahasti.kalamkari",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "predev": "echo 'Skipping tests for faster dev. Run: npm test'",
    "dev": "next dev --webpack",
    "dev:full": "npm test && next dev --webpack",
    "prebuild": "npm test",
    "build": "next build --webpack",
    "build:analyze": "cross-env ANALYZE=true next build",
    "build:profile": "next build --profile",
    "export": "next build && next export",
    "start": "next start",
    "build:hostinger": "npm run build && rm -f deploy.zip && zip -r deploy.zip .next src public supabase/migrations server.js package.json package-lock.json next.config.mjs tailwind.config.ts postcss.config.js tsconfig.json -x '*.DS_Store' -x '.next/cache/*' -x '.next/dev/*' && echo '✅ deploy.zip ready. Hostinger entry point: server.js'",
    "deploy": "node scripts/deploy.js",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --coverage",
    "images:migrate:dry-run": "node scripts/migrate-supabase-images-to-cloudflare.mjs",
    "images:migrate:apply": "node scripts/migrate-supabase-images-to-cloudflare.mjs --apply",
    "images:migrate:verify": "node scripts/migrate-supabase-images-to-cloudflare.mjs --verify"
  },
